# 서버 전용. 이 파일을 .env로 복사해서 채운다. (프론트 번들에는 절대 들어가지 않음)
PORT=8787

# mock = API 비용 없이 전체 플로우 확인 (분석은 고정 예시, 시안은 셀카를 그대로 돌려줌)
# gemini = 실제 분석·생성 (결제 등록된 GEMINI_API_KEY 필요)
AI_MODE=mock

# Google Gemini (https://aistudio.google.com/apikey) — 무료 등급 없음
GEMINI_API_KEY=
# 시안 생성 (2026-10 실측: 1K 1장 약 68원, 재시도도 별도 과금)
GEMINI_MODEL=gemini-nano-banana-2.1
# 1K 권장 (2K, 4K는 비용·지연 증가)
GEMINI_IMAGE_SIZE=1K
# 모발 분석·스타일 추천 (1회 약 1.6~2원, 5초)
GEMINI_ANALYZE_MODEL=gemini-3.5-flash-lite
# 분석 모델 과부하(429/5xx) 시 1회 재시도 후 넘어갈 대체 모델 (비우면 사용 안 함)
GEMINI_ANALYZE_FALLBACK_MODEL=gemini-3.8-flash
# 1이면 응답 구조를 서버 콘솔에 출력
GEMINI_DEBUG=0

# 시안 프롬프트 버전 (v1 | v2). 결과와 함께 기록된다.
PROMPT_VERSION=v1

# 사용자(브라우저)별 하루 시안 생성 횟수. 비우면 제한 없음 (정책 미정)
GENERATION_DAILY_LIMIT=
GENERATION_TIMEOUT_MS=60000
ANALYSIS_TIMEOUT_MS=30000

# 이벤트 로그(JSONL) 위치. 사진은 기록하지 않는다. git 제외.
LOG_DIR=logs

# MockProvider 응답 지연
MOCK_DELAY_MIN_MS=800
MOCK_DELAY_MAX_MS=2500
